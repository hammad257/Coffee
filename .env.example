# Copy this file to `.env` (gitignored).

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/coffee_shop"
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Access JWT (minimum 32 random bytes hex in production)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Used only client-side expiry hint logic if you encode refresh JWT later.
# Refresh tokens stored in DB are opaque; TTL is computed from JWT_REFRESH_EXPIRES_IN (+ 30d when rememberMe).
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Optional: override default password for seeded manager/admin (default = ChangeMe!2026)
# SEED_MANAGER_PASSWORD=
