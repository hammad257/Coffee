generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String         @map("password_hash")
  firstName        String         @map("first_name")
  lastName         String         @map("last_name")
  status           UserStatus     @default(PENDING) @map("status")
  twoFactorEnabled Boolean        @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime?      @map("last_login_at")
  /// Bumped on logout-everywhere / theft / admin RBAC changes → invalidates JWTs.
  tokenVersion     Int            @default(0) @map("token_version")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  createdById      String?        @map("created_by_id")
  updatedById      String?        @map("updated_by_id")
  deletedAt        DateTime?      @map("deleted_at")
  photoUrl         String?        @map("photo_url")
  refreshTokens    RefreshToken[]
  userRoles        UserRole[]
  ordersCreated    Order[]        @relation("OrderCreatedBy")
  ordersAssigned   Order[]        @relation("OrderAssignedTo")

  @@index([email])
  @@index([status])
  @@map("users")
}


model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  rememberMe Boolean   @default(false) @map("remember_me")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Role {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  module          String
  resource        String
  action          String
  description     String?
  rolePermissions RolePermission[]

  @@index([module, resource])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")
  role       Role     @relation(fields: [roleId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  grantedAt    DateTime   @default(now()) @map("granted_at")
  grantedBy    String?    @map("granted_by")
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// --- POS catalog ---

model ProductCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@index([isActive])
  @@map("product_categories")
}

model Product {
  id          String            @id @default(uuid())
  categoryId  String            @map("category_id")
  category    ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Human-facing SKU/barcode for admin listings (unique when set).
  sku         String?           @unique
  name        String
  description String?
  /// Selling price (menu / POS).
  price       Decimal           @db.Decimal(12, 2)
  /// COGS / internal cost (Add Product screen).
  costPrice   Decimal           @default(0) @map("cost_price") @db.Decimal(12, 2)
  imageUrl    String?           @map("image_url")
  outOfStock  Boolean           @default(false) @map("out_of_stock")
  /// Estimated units on hand (POS ingredient / retail stock).
  stockQuantity     Int         @default(500) @map("stock_quantity")
  /// Trigger LOW_STOCK when stockQuantity is in (0, threshold] unless out_of_stock forced.
  lowStockThreshold Int         @default(10) @map("low_stock_threshold")
  /// Email / dashboard alerts when crossing low-stock (Product admin).
  autoRefillAlerts Boolean      @default(true) @map("auto_refill_alerts")
  /// Save as draft (not visible on POS until published).
  isDraft     Boolean           @default(false) @map("is_draft")
  /// Optional size/variant options, e.g. [{ "key":"m","label":"Medium (12oz)","priceModifier":0.5 }]
  variants    Json?             @map("variants")
  /// Optional add-ons, e.g. [{ "name":"Extra shot","price":0.8 }]
  addons      Json?             @map("addons")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isDraft])
  @@map("products")
}

// --- Dine-in floor ---

model DineTable {
  id            String      @id @default(uuid())
  label         String      @unique
  capacity      Int         @default(4)
  status        TableStatus @default(FREE)
  /// Denormalized pointer to the currently open order for this table (dine-in).
  activeOrderId String?     @unique @map("active_order_id")
  activeOrder   Order?      @relation("TableActiveOrder", fields: [activeOrderId], references: [id])
  seatedOrders  Order[]     @relation("OrderSeatedAt")

  @@map("dine_tables")
}

// --- Orders ---

model Order {
  id               String               @id @default(uuid())
  orderNumber      String               @unique @map("order_number")
  status           OrderStatus
  type             OrderType            @map("order_type")
  fulfillment      FulfillmentMethod?   @map("fulfillment")
  /// Staff responsible for fulfilment / floor assignment (shows as “assigned” on POS).
  assignedToId     String?              @map("assigned_to_id")
  assignedTo       User?                @relation("OrderAssignedTo", fields: [assignedToId], references: [id])
  /// Dine-in: optional table assignment
  tableId          String?              @map("table_id")
  seatedAtTable    DineTable?           @relation("OrderSeatedAt", fields: [tableId], references: [id])
  occupiesTableRow DineTable?           @relation("TableActiveOrder")
  customerName     String?              @map("customer_name")
  customerPhone    String?              @map("customer_phone")
  customerAddress  String?              @map("customer_address")
  baristaNote      String?              @map("barista_note")
  /// Snapshot tax rate at time of order (e.g. 0.08)
  taxRate          Decimal              @default(0.08) @map("tax_rate") @db.Decimal(7, 4)
  subtotal         Decimal              @db.Decimal(12, 2)
  taxAmount        Decimal              @map("tax_amount") @db.Decimal(12, 2)
  deliveryFee      Decimal              @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  total            Decimal              @db.Decimal(12, 2)
  paymentMethod    PaymentMethod?       @map("payment_method")
  paymentLast4     String?              @map("payment_last4")
  /// Latest Stripe PaymentIntent id for ONLINE card flows (verify webhooks against this row).
  stripePaymentIntentId String?         @unique @map("stripe_payment_intent_id")
  paymentStatus    PaymentStatus        @default(PENDING) @map("payment_status")
  /// Cash / in-person tenders (success screen shows tendered vs change due).
  amountTendered   Decimal?             @map("amount_tendered") @db.Decimal(12, 2)
  changeDue        Decimal?             @map("change_due") @db.Decimal(12, 2)
  completedAt      DateTime?            @map("completed_at")
  cancelledAt      DateTime?            @map("cancelled_at")
  createdById      String               @map("created_by_id")
  createdBy        User                 @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items            OrderItem[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([createdById])
  @@index([assignedToId])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?  @map("product_id")
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String   @map("product_name")
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(12, 2)
  modifiersNote  String?  @map("modifiers_note")

  @@index([orderId])
  @@map("order_items")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum OrderStatus {
  DRAFT
  NEW
  PREPARING
  READY
  /// Dine-in: food/drink handed at the table — still unpaid until POS completes payment.
  SERVED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  HELD
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  ONLINE
}

enum FulfillmentMethod {
  COUNTER_PICKUP
  CURBSIDE
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  /// QR wallet / QR code tenders (checkout screen tab).
  QR
  ONLINE
  OTHER
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}
